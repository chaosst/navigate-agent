{
    "name": "navigate",
    "version": "0.1.0",
    "type": "module",
    "scripts": {
        "db:ensure": "docker-compose ps -q postgres | findstr . >nul 2>&1 || docker-compose up -d postgres",
        "dev": "npm run tui",
        "tui": "npm run db:ensure && tsx src/index.ts",
        "server": "npm run db:ensure && tsx src/server-entry.ts",
        "build": "tsc",
        "start": "node dist/server-entry.js",
        "gen-token": "tsx scripts/gen-token.ts",
        "db:up": "docker-compose up -d",
        "db:down": "docker-compose down",
        "db:import": "tsx scripts/import-from-sqlite.ts",
        "db:reset": "docker-compose down -v && docker-compose up -d",
        "dev:zyplayer": "docker-compose -f docker-compose.zyplayer.yml up -d",
        "test": "vitest run --dir src",
        "test:watch": "vitest --dir src",
        "mytest": "tsx src/test.ts"
    },
    "dependencies": {
        "@langchain/core": "^1.2.5",
        "@langchain/langgraph": "^1.4.9",
        "@langchain/openai": "^1.5.6",
        "@langchain/textsplitters": "^1.0.1",
        "@modelcontextprotocol/sdk": "^1.29.0",
        "dotenv": "^16.0.0",
        "express": "^5.2.1",
        "ink": "^5.0.0",
        "js-yaml": "^5.2.1",
        "langchain": "^1.5.4",
        "mammoth": "^1.12.0",
        "multer": "^2.2.0",
        "mysql2": "^3.23.2",
        "pdf-parse": "^2.4.5",
        "pg": "^8.22.0",
        "react": "^18.0.0",
        "sql.js": "^1.11.0",
        "typescript": "^5.4.0",
        "undici": "^6.28.0",
        "zod": "^3.23.0"
    },
    "devDependencies": {
        "@types/express": "^5.0.6",
        "@types/js-yaml": "^4.0.9",
        "@types/multer": "^2.2.0",
        "@types/pg": "^8.20.0",
        "@types/react": "^18.0.0",
        "@types/sql.js": "^1.4.11",
        "tsx": "^4.0.0",
        "vitest": "^4.1.10"
    },
    "engines": {
        "node": ">=18"
    }
}
