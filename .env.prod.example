# ============================================================
# navigate 生产环境变量模板
# 复制为 .env.prod 后填入真实值，.env.prod 不要提交到 git！
# 注意：本文件同时被 compose --env-file 读取（${POSTGRES_PASSWORD}/${DOMAIN} 变量替换）
# ============================================================

# ── 必填 ──
OPENAI_API_KEY=sk-your-real-key-here
# 数据库密码：换成强密码（>=16 位，含大小写+数字）
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ── LLM ──
OPENAI_MODEL=gpt-4o
# OPENAI_BASE_URL=https://api.openai.com/v1
MAX_ITERATIONS=25

# ── 数据库连接（app 服务内由 compose 自动拼 DATABASE_URL，无需手填）──
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=6

# ── H5 登录（公网部署务必改密码）──
H5_LOGIN_USERNAME=admin
H5_LOGIN_PASSWORD=CHANGE_ME_LOGIN_PASSWORD
# H5_LOGIN_USERS=[{"username":"alice","password":"pw1"}]

# ── API 鉴权（强烈建议配置，公网不裸奔）──
# API_KEYS=sk-aaa:2026-12-31T00:00:00Z
# API_IP_WHITELIST=127.0.0.1
API_FAILURE_LIMIT=5
API_FAILURE_WINDOW_MS=60000

# ── 执行模式：normal | plan | ptc ──
# AGENT_MODE=normal

# ── Caddy 域名（韩国节点免备案，解析 A 记录到服务器 IP 后自动 HTTPS）──
# 没有域名时先不填，部署用 `docker compose up -d app postgres`（跳过 caddy）
DOMAIN=navigate.example.com

# ── 公网地址（wiki 子域名方案，修 H5 页面 localhost:3003 硬编码）──
# 1) 先给 wiki 子域名加 A 记录（wiki.你的域名 → 服务器 IP），Caddyfile 已启用反代
# 2) 配置下面两个地址后重建，H5 页面的 Wiki 链接才会指向公网：
# H5_WIKI_PUBLIC_URL=https://wiki.navigate.example.com   # H5 页面 Wiki 链接 + 登录 next 白名单
# H5_PUBLIC_BASE_URL=https://navigate.example.com        # 主站公网地址（wiki 代理未登录时跳公网登录页）
# 3) 可选：cookie 自动推导根域（.example.com）一般够用；有多个二级后缀域名时强制指定：
# H5_COOKIE_DOMAIN=.example.com
# 4) 未配置时全部回退 localhost（本地开发 / SSH 隧道场景行为不变）

# ── zyplayer-doc 知识库（生产 compose 已内置 zyplayer-mysql/zyplayer-doc 服务）──
# wiki 代理 target 指向 compose 内网服务名（不是 localhost！）
H5_WIKI_TARGET=http://zyplayer-doc:8083
# 代理自动登录 zyplayer-doc 的账号（rsa 模式 = 前端 RSA 加密密码，zyplayer-doc 专用）
# H5_WIKI_USERNAME=zyplayer
# H5_WIKI_PASSWORD=<zyplayer-doc 真实密码>
# H5_WIKI_LOGIN_MODE=rsa
# 知识库内容同步（wiki-sync 读 MySQL 同步到 RAG）
ZYPLAYER_MYSQL_HOST=zyplayer-mysql
ZYPLAYER_MYSQL_PORT=3306
ZYPLAYER_MYSQL_USER=zyplayer
ZYPLAYER_MYSQL_PASSWORD=zyplayer_pass
ZYPLAYER_MYSQL_DB=zyplayer_doc
