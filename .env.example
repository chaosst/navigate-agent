OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=
MAX_ITERATIONS=25

# PostgreSQL (三层存储架构)
DATABASE_URL=postgresql://navigate:navigate@localhost:5432/navigate
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# zyplayer-doc 知识库系统（可选）
# ZYPLAYER_DOC_URL=http://localhost:8083
# ZYPLAYER_MYSQL_HOST=localhost
# ZYPLAYER_MYSQL_PORT=3307
# ZYPLAYER_MYSQL_USER=zyplayer
# ZYPLAYER_MYSQL_PASSWORD=your-password-here
# ZYPLAYER_MYSQL_DB=zyplayer_doc

# 固定 API key + MCP 端点鉴权
# API_KEYS=sk-aaa:2026-12-31T00:00:00Z,sk-bbb
# API_KEY=sk-legacy
# API_IP_WHITELIST=127.0.0.1,10.0.0.0/8
# API_SIGNATURE_WINDOW_MS=300000
# API_TRUST_PROXY=false
# 失败鉴权限流:窗口内同 IP 失败达到 API_FAILURE_LIMIT 次 → 429
# API_FAILURE_LIMIT=5
# API_FAILURE_WINDOW_MS=60000

# === H5 登录系统（本地账号密码）===
H5_LOGIN_USERNAME=admin
H5_LOGIN_PASSWORD=change-me
# 或用 JSON 数组配置多账号（优先于上面的单账号）
# H5_LOGIN_USERS=[{"username":"alice","password":"pw1"},{"username":"bob","password":"pw2"}]
# HTTPS 部署时设 true，cookie 才带 Secure
# H5_COOKIE_SECURE=false

# === wiki 鉴权反向代理（默认 3002 → http://localhost:8083）===
# H5_WIKI_PROXY_PORT=3002
# H5_WIKI_TARGET=http://localhost:8083
