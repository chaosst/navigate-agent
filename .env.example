OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=
MAX_ITERATIONS=25
# embedding 模型（摘要/向量检索用）。若 baseURL 无该模型，摘要检索自动降级关键词。
# 例：阿里云 DashScope 用 text-embedding-v3；OpenAI 用 text-embedding-3-small
# EMBEDDING_MODEL=text-embedding-3-small
# 无进展循环检测阈值：同一 (tool, 参数) 连续返回相同结果达到该次数即强制终止（默认 3）。
# 想更宽容可调大（如 5），想更严格可调小。
# REPETITION_LIMIT=3

# === web_search 工具代理（DuckDuckGo 被墙时经代理出网）===
# 优先级：显式 WEB_SEARCH_PROXY > 标准的 HTTP(S)_PROXY / NO_PROXY（Node fetch 自动识别）
# 例：您的本地代理端口 7890，填: http://127.0.0.1:7890
# WEB_SEARCH_PROXY=

# PostgreSQL (三层存储架构)
DATABASE_URL=postgresql://navigate:navigate@localhost:5432/navigate
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# zyplayer-doc 知识库系统（可选）
# ZYPLAYER_DOC_URL=http://localhost:8083
# ZYPLAYER_MYSQL_HOST=localhost
# ZYPLAYER_MYSQL_PORT=3307
# ZYPLAYER_MYSQL_USER=zyplayer
# ZYPLAYER_MYSQL_PASSWORD=your-password-here
# ZYPLAYER_MYSQL_DB=zyplayer_doc

# 固定 API key + MCP 端点鉴权
# API_KEYS=sk-aaa:2026-12-31T00:00:00Z,sk-bbb
# API_KEY=sk-legacy
# API_IP_WHITELIST=127.0.0.1,10.0.0.0/8
# API_SIGNATURE_WINDOW_MS=300000
# API_TRUST_PROXY=false
# 失败鉴权限流:窗口内同 IP 失败达到 API_FAILURE_LIMIT 次 → 429
# API_FAILURE_LIMIT=5
# API_FAILURE_WINDOW_MS=60000

# === H5 登录系统（本地账号密码）===
# 管理员账号（role=admin，可管理文档、改体验账号密码）
H5_LOGIN_USERNAME=admin
H5_LOGIN_PASSWORD=change-me
# 体验账号（role=guest，给 HR/面试官）：只能访问 文档管理(只读)/简历/简历问答/JD匹配，
# 上传/重新索引/删除 与 账号管理页 均无权限；未配置则不启用体验登录
# H5_GUEST_USERNAME=guest
# H5_GUEST_PASSWORD=change-me-too
# 或用 JSON 数组配置多账号（优先于上面的单账号对；role 可选，缺省 admin，体验账号写 "guest"）
# H5_LOGIN_USERS=[{"username":"alice","password":"pw1"},{"username":"guest","password":"pw2","role":"guest"}]
# 管理员在 /admin 页改过密码后，账号以 rag_data/h5-users.json 为准（改 .env 需删该文件重启才生效）
# HTTPS 部署时设 true，cookie 才带 Secure
# H5_COOKIE_SECURE=false

# === wiki 鉴权反向代理（默认 3003 → http://localhost:8083）===
# H5_WIKI_PROXY_PORT=3003
# H5_WIKI_TARGET=http://localhost:8083
# 默认（不配 wiki 账号）：代理纯透传。zyplayer-doc 登录态存在浏览器 localStorage，
# 直接在浏览器打开 http://localhost:3003 手动登录一次 wiki 即可长期免登录。
# 如需代理自动登录，配置 wiki 账号即启用：
# H5_WIKI_USERNAME=zyplayer
# H5_WIKI_PASSWORD=<你的 wiki 真实密码>
# wiki 登录方式: form(Spring Security 表单+csrf)、json、或 rsa(zyplayer-doc 前端 RSA 加密密码)
# rsa 模式: 代理先 POST /loginConfig 拿公钥+sessionId，再 RSA-PKCS1 加密密码 POST /login，
#           捕获 accessToken cookie 注入上游请求（已针对 zyplayer-doc 验证）
# H5_WIKI_LOGIN_MODE=rsa
# H5_WIKI_LOGIN_PATH=/login
# form 模式是否提取登录页的 _csrf（默认 true）
# H5_WIKI_LOGIN_CSRF=true
# wiki 会话缓存时长(秒)，到期自动重新登录（默认 600）
# H5_WIKI_SESSION_TTL_SEC=600
# 品牌名 + 主题色 + 轻度布局注入（方案 A）：经 3003 代理访问 zyplayer-doc 时
# 注入 <style> 把 Element Plus + Ant Design Vue 颜色统一为 Navigate Wiki 主题，
# 注入 <script> 把品牌名/标题/Powered by 替换为 Navigate Wiki。
# 不动 zyplayer-doc 容器 / JAR / MySQL；改动仅限品牌色 / 阴影 / 字距 / 卡片圆角等
# 表层视觉属性，DOM 结构与框架布局保持 zyplayer-doc 原生。
# H5_WIKI_INJECT=true          # 默认开启；false 关闭注入（纯透传）
# H5_WIKI_BRAND=Navigate Wiki  # 品牌名，默认 "Navigate Wiki"
# H5_WIKI_THEME=#519670        # 主题色（hex），默认 #519670 柔绿

# # 执行模式：normal | plan | ptc
# AGENT_MODE=normal

# # PTC 模式预算
# PTC_MAX_PROGRAM_LENGTH=16384
# PTC_MAX_WALL_MS=60000
# PTC_MAX_COMPUTE_MS=30000
# PTC_MAX_OUTPUT_BYTES=65536
# PTC_MAX_PARALLEL_SUBCALLS=10
# PTC_TOOL_MODE=code

# === 推理引擎适配层 ===
# PROVIDER=openai 时行为与之前完全一致（默认值，可省略不写）
# PROVIDER=ollama | vllm | sglang 时走本地 OpenAI 兼容端点：
#   ollama: http://localhost:11434/v1（qwen2.5:7b，CPU 可跑）
#   vllm:   http://localhost:8000/v1（Qwen2.5-7B-Instruct，需 NVIDIA GPU，未实测）
#   sglang: http://localhost:30000/v1（Qwen2.5-7B-Instruct，需 NVIDIA GPU，未实测）
# 本地后端 OPENAI_API_KEY 仅作占位，可不填。
# 覆盖优先级（2026-09 方案 A）：专属变量 > OPENAI_*（通用兜底）> 内置默认
#   openai 专属 = OPENAI_BASE_URL / OPENAI_MODEL
#   ollama 专属 = OLLAMA_BASE_URL / OLLAMA_MODEL
#   vllm   专属 = VLLM_BASE_URL / VLLM_MODEL
#   sglang 专属 = SGLANG_BASE_URL / SGLANG_MODEL
# 例：切 ollama 并绕开 .env 里常驻的 OPENAI_*（防云端配置串扰）——配专属变量即可：
#   PROVIDER=ollama
#   OLLAMA_MODEL=qwen2.5:14b
# 注意：若只设 PROVIDER 而不配专属变量，OPENAI_BASE_URL / OPENAI_MODEL 仍会作为
# 兜底生效（旧 .env 行为不变）。
# EMBEDDING_BASE_URL / EMBEDDING_MODEL：embedding 专用端点（可选，全局有效）。
#   不设置 EMBEDDING_BASE_URL 时 embedding 跟随 chat 的 baseURL。
#   典型拆分场景：chat 走 DeepSeek、向量化走本地 ollama：
#     EMBEDDING_BASE_URL=http://localhost:11434/v1
#     EMBEDDING_MODEL=nomic-embed-text
# PROVIDER=openai